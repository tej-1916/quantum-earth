# Quantum Earth Lab - Environment Configuration Template
# Copy this file to .env and populate with your local values.
# NEVER commit .env to version control.

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# NASA Earthdata API Credentials (Optional, for higher rate limits on CMR queries)
# Get a free token at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_TOKEN=

# IBM Quantum Credentials (Reserved for Milestone D hardware validation)
# Get an API token from: https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=ibm-q/open/main

# Model and Data Directories
EUROSAT_DATA_DIR=./data/eurosat
CHECKPOINT_DIR=./checkpoints
